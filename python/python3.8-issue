def trim_message(history, length):
    d = list(map(lambda xs: len(json.dumps(xs,ensure_ascii=False).encode('utf8')), history))
    #d=[20, 10, 30, 40, 70, 20, 30, 10]
    print(d)
    d1=reversed(d)
    index=0
    for n, r in enumerate(accumulate(d1)):
        #print(n, r)
        if r > length:
            if n == 0 or n == 1:
                return history[-1]
            else:
                index = n
                break
    
    # print(d[-index:])
    return(history[-index:])

